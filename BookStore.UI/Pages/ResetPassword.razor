@page "/reset-password"
@inject IAuthenticationService AuthService
@inject ToastService ToastService

<PageTitle>تعیین رمز عبور جدید</PageTitle>

@if (Done)
{
    <div class="auth-card">
        <h1 class="auth-title">انجام شد</h1>
        <p class="auth-subtitle">رمز عبور شما با موفقیت تغییر کرد. حالا با رمز جدید وارد شوید.</p>
        <a class="auth-button auth-button-link" href="login">ورود به حساب</a>
    </div>
}
else if (_invalidLink)
{
    // A broken/missing link is a page state (like Done), not a transient operation — keep it prominent.
    <ErrorNotice Title="لینک بازیابی معتبر نیست"
                 Message="این لینک ناقص است یا منقضی شده. لطفاً دوباره از ایمیل خود لینک جدیدی دریافت کنید."
                 ShowRetry="false" />
}
else
{
    <div class="auth-card">
        <h1 class="auth-title">رمز عبور جدید</h1>
        <p class="auth-subtitle">برای @Email</p>

        <form @onsubmit="HandleSubmit" novalidate>
            <div class="auth-field">
                <label for="password">رمز عبور جدید</label>
                <input id="password" type="password" class="form-control" @bind="Password" autocomplete="new-password" />
                @if (FieldErrors.TryGetValue("password", out var passwordError))
                {
                    <span class="field-error">@passwordError</span>
                }
            </div>

            <div class="auth-field">
                <label for="confirm">تکرار رمز عبور</label>
                <input id="confirm" type="password" class="form-control" @bind="ConfirmPassword" autocomplete="new-password" />
                @if (FieldErrors.TryGetValue("confirm", out var confirmError))
                {
                    <span class="field-error">@confirmError</span>
                }
            </div>

            <button type="submit" class="auth-button" disabled="@IsBusy">
                <i class="bi @(IsBusy ? "bi-arrow-repeat bi-spin" : "bi-key")" aria-hidden="true"></i>
                @(IsBusy ? "در حال ذخیره..." : "ذخیرهٔ رمز عبور")
            </button>
        </form>

        <p class="auth-switch">
            <a href="login">بازگشت به ورود</a>
        </p>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? EmailParam { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenParam { get; set; }

    private string Email = string.Empty;
    private string Token = string.Empty;
    private string Password = string.Empty;
    private string ConfirmPassword = string.Empty;
    private bool IsBusy;
    private bool Done;
    private bool _invalidLink;
    private Dictionary<string, string> FieldErrors = new();

    protected override void OnInitialized()
    {
        Email = EmailParam ?? string.Empty;
        Token = TokenParam ?? string.Empty;

        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            _invalidLink = true;
        }
    }

    private async Task HandleSubmit()
    {
        FieldErrors = new();

        if (string.IsNullOrWhiteSpace(Password))
        {
            FieldErrors["password"] = "رمز عبور را وارد کنید.";
        }
        else if (Password.Length < 8)
        {
            FieldErrors["password"] = "رمز عبور باید حداقل ۸ کاراکتر باشد.";
        }

        if (string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            FieldErrors["confirm"] = "تکرار رمز عبور را وارد کنید.";
        }
        else if (ConfirmPassword != Password)
        {
            FieldErrors["confirm"] = "تکرار رمز عبور مطابقت ندارد.";
        }

        if (FieldErrors.Count > 0)
        {
            return;
        }

        IsBusy = true;
        try
        {
            await AuthService.ResetPasswordAsync(Email.Trim(), Token.Trim(), Password);
            Done = true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
