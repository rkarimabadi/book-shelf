@page "/forgot-password"
@inject IAuthenticationService AuthService

<PageTitle>بازیابی رمز عبور</PageTitle>

<div class="auth-card">
    <h1 class="auth-title">بازیابی رمز عبور</h1>

    @if (Sent)
    {
        <div class="auth-success" role="status">
            اگر ایمیل <strong>@Email</strong> در سیستم ثبت شده باشد، لینک بازیابی رمز عبور برایتان ارسال شد.
            لطفاً صندوق ورودی (و پوشهٔ اسپم) را بررسی کنید.
        </div>
        <p class="auth-switch">
            <a href="login">بازگشت به ورود</a>
        </p>
    }
    else
    {
        <p class="auth-subtitle">ایمیل خود را وارد کنید؛ لینک بازیابی رمز عبور برایتان ارسال می‌شود</p>

        <form @onsubmit="HandleSubmit" novalidate>
            <div class="auth-field">
                <label for="email">ایمیل</label>
                <input id="email" type="email" class="form-control" @bind="Email" autocomplete="email" />
                @if (FieldErrors.TryGetValue("email", out var emailError))
                {
                    <span class="field-error">@emailError</span>
                }
            </div>

            @if (ErrorMessage is not null)
            {
                <div class="auth-error" role="alert">@ErrorMessage</div>
            }

            <button type="submit" class="auth-button" disabled="@IsBusy">
                @(IsBusy ? "در حال ارسال..." : "ارسال لینک بازیابی")
            </button>
        </form>

        <p class="auth-switch">
            <a href="login">بازگشت به ورود</a>
        </p>
    }
</div>

@code {
    private string Email = string.Empty;
    private bool IsBusy;
    private bool Sent;
    private string? ErrorMessage;
    private Dictionary<string, string> FieldErrors = new();

    private async Task HandleSubmit()
    {
        ErrorMessage = null;
        FieldErrors = new();

        if (string.IsNullOrWhiteSpace(Email))
        {
            FieldErrors["email"] = "ایمیل را وارد کنید.";
        }
        else if (!Email.Contains('@'))
        {
            FieldErrors["email"] = "ایمیل معتبر نیست.";
        }

        if (FieldErrors.Count > 0)
        {
            return;
        }

        IsBusy = true;
        try
        {
            await AuthService.ForgotPasswordAsync(Email.Trim());
            Sent = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }
}
