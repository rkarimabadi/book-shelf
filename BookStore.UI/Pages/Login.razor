@page "/login"
@inject IAuthenticationService AuthService
@inject NavigationManager Nav
@inject ToastService ToastService

<PageTitle>ورود</PageTitle>

<div class="auth-card">
    <h1 class="auth-title">ورود</h1>
    <p class="auth-subtitle">برای ادامه، وارد حساب خود شوید</p>

    @if (GoogleEnabled)
    {
        <a class="google-button" href="@GoogleLoginUrl">
            <i class="bi bi-google" aria-hidden="true"></i>
            ورود با گوگل
        </a>
        <div class="auth-divider" role="separator"><span>یا</span></div>
    }

    <form @onsubmit="HandleLogin" novalidate>
        <div class="auth-field">
            <label for="email">ایمیل</label>
            <input id="email" type="email" class="form-control" @bind="Email" autocomplete="email" />
            @if (FieldErrors.TryGetValue("email", out var emailError))
            {
                <span class="field-error">@emailError</span>
            }
        </div>

        <div class="auth-field">
            <label for="password">رمز عبور</label>
            <input id="password" type="password" class="form-control" @bind="Password" autocomplete="current-password" />
            @if (FieldErrors.TryGetValue("password", out var passwordError))
            {
                <span class="field-error">@passwordError</span>
            }
        </div>

        <div class="auth-links">
            <a href="forgot-password">رمز عبور را فراموش کرده‌اید؟</a>
        </div>

        <button type="submit" class="auth-button" disabled="@IsBusy">
            <i class="bi @(IsBusy ? "bi-arrow-repeat bi-spin" : "bi-box-arrow-in-left")" aria-hidden="true"></i>
            @(IsBusy ? "در حال ورود..." : "ورود")
        </button>
    </form>

    <p class="auth-switch">
        حساب ندارید؟ <a href="register">ثبت‌نام کنید</a>
    </p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string Email = string.Empty;
    private string Password = string.Empty;
    private bool IsBusy;
    private bool GoogleEnabled;
    private Dictionary<string, string> FieldErrors = new();

    private string GoogleLoginUrl =>
        $"/api/auth/google-login?returnUrl={Uri.EscapeDataString(ReturnUrl is { } url && url.StartsWith('/') ? url : "/")}";

    protected override async Task OnInitializedAsync()
    {
        GoogleEnabled = await AuthService.IsGoogleEnabledAsync();
    }

    private async Task HandleLogin()
    {
        FieldErrors = new();

        if (string.IsNullOrWhiteSpace(Email))
        {
            FieldErrors["email"] = "ایمیل را وارد کنید.";
        }
        else if (!Email.Contains('@'))
        {
            FieldErrors["email"] = "ایمیل معتبر نیست.";
        }

        if (string.IsNullOrWhiteSpace(Password))
        {
            FieldErrors["password"] = "رمز عبور را وارد کنید.";
        }

        if (FieldErrors.Count > 0)
        {
            return;
        }

        IsBusy = true;
        try
        {
            var result = await AuthService.LoginAsync(new LoginRequest(Email.Trim(), Password));
            var name = string.IsNullOrWhiteSpace(result.FirstName) ? string.Empty : $"، {result.FirstName}";
            ToastService.ShowSuccess($"خوش آمدید{name}!");
            Nav.NavigateTo(ReturnUrl is { } url && url.StartsWith('/') ? url : "/");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
