@page "/change-password"
@attribute [Authorize]
@inject IAuthenticationService AuthService
@inject AuthStateProvider AuthState
@inject NavigationManager Nav
@inject ToastService ToastService

<PageTitle>@(HasPassword ? "تغییر رمز عبور" : "تعیین رمز عبور")</PageTitle>

@if (Done)
{
    <div class="auth-card">
        <h1 class="auth-title">انجام شد</h1>
        <p class="auth-subtitle">رمز عبور شما با موفقیت @(HasPassword ? "تغییر کرد" : "تنظیم شد"). برای امنیت بیشتر، از همهٔ دستگاه‌ها خارج شدید و باید دوباره وارد شوید.</p>
        <a class="auth-button auth-button-link" href="login">ورود به حساب</a>
    </div>
}
else if (!Loading)
{
    <div class="auth-card">
        <h1 class="auth-title">@(HasPassword ? "تغییر رمز عبور" : "تعیین رمز عبور")</h1>
        <p class="auth-subtitle">
            @(HasPassword
                ? "برای تغییر رمز، ابتدا رمز فعلی را وارد کنید"
                : "حساب شما با گوگل ساخته شده است؛ برای ورود با ایمیل و رمز، یک رمز عبور برای آن تعیین کنید")
        </p>

        <form @onsubmit="HandleSubmit" novalidate>
            @if (HasPassword)
            {
                <div class="auth-field">
                    <label for="current">رمز عبور فعلی</label>
                    <input id="current" type="password" class="form-control" @bind="CurrentPassword" autocomplete="current-password" />
                    @if (FieldErrors.TryGetValue("current", out var currentError))
                    {
                        <span class="field-error">@currentError</span>
                    }
                </div>
            }

            <div class="auth-field">
                <label for="password">رمز عبور جدید</label>
                <input id="password" type="password" class="form-control" @bind="Password" autocomplete="new-password" />
                @if (FieldErrors.TryGetValue("password", out var passwordError))
                {
                    <span class="field-error">@passwordError</span>
                }
            </div>

            <div class="auth-field">
                <label for="confirm">تکرار رمز عبور جدید</label>
                <input id="confirm" type="password" class="form-control" @bind="ConfirmPassword" autocomplete="new-password" />
                @if (FieldErrors.TryGetValue("confirm", out var confirmError))
                {
                    <span class="field-error">@confirmError</span>
                }
            </div>

            <button type="submit" class="auth-button" disabled="@IsBusy">
                <i class="bi @(IsBusy ? "bi-arrow-repeat bi-spin" : "bi-shield-lock")" aria-hidden="true"></i>
                @(IsBusy ? "در حال ذخیره..." : "ذخیرهٔ رمز عبور")
            </button>
        </form>
    </div>
}
else
{
    <div class="auth-card">
        <LoadingSpinner />
    </div>
}

@code {
    private string CurrentPassword = string.Empty;
    private string Password = string.Empty;
    private string ConfirmPassword = string.Empty;
    private bool IsBusy;
    private bool Done;
    private bool Loading = true;
    private bool HasPassword = true;
    private Dictionary<string, string> FieldErrors = new();

    protected override async Task OnInitializedAsync()
    {
        // Google-created accounts have no usable password; they SET one without proving a
        // current password (the server skips verification when HasPassword == false).
        // Loading guards the form so a passwordless account never flashes the "change"
        // mode with a current-password field before the flag arrives.
        HasPassword = await AuthService.HasPasswordAsync();
        Loading = false;
    }

    private async Task HandleSubmit()
    {
        FieldErrors = new();

        if (HasPassword && string.IsNullOrWhiteSpace(CurrentPassword))
        {
            FieldErrors["current"] = "رمز عبور فعلی را وارد کنید.";
        }

        if (string.IsNullOrWhiteSpace(Password))
        {
            FieldErrors["password"] = "رمز عبور جدید را وارد کنید.";
        }
        else if (Password.Length < 8)
        {
            FieldErrors["password"] = "رمز عبور باید حداقل ۸ کاراکتر باشد.";
        }

        if (string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            FieldErrors["confirm"] = "تکرار رمز عبور را وارد کنید.";
        }
        else if (ConfirmPassword != Password)
        {
            FieldErrors["confirm"] = "تکرار رمز عبور مطابقت ندارد.";
        }

        if (FieldErrors.Count > 0)
        {
            return;
        }

        IsBusy = true;
        try
        {
            // Passwordless (Google) accounts pass null — no current password to verify.
            await AuthService.ChangePasswordAsync(HasPassword ? CurrentPassword : null, Password);
            await AuthService.LogoutAsync(AuthState.CurrentSession?.RefreshToken ?? string.Empty);
            Done = true;
        }
        catch (Exception ex)
        {
            // ex.Message is already translated to Persian by AuthenticationService.
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
