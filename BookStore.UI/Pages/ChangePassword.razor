@page "/change-password"
@attribute [Authorize]
@inject IAuthenticationService AuthService
@inject AuthStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>تغییر رمز عبور</PageTitle>

@if (Done)
{
    <div class="auth-card">
        <h1 class="auth-title">انجام شد</h1>
        <p class="auth-subtitle">رمز عبور شما با موفقیت تغییر کرد. برای امنیت بیشتر، از همهٔ دستگاه‌ها خارج شدید و باید دوباره وارد شوید.</p>
        <a class="auth-button auth-button-link" href="login">ورود به حساب</a>
    </div>
}
else
{
    <div class="auth-card">
        <h1 class="auth-title">تغییر رمز عبور</h1>
        <p class="auth-subtitle">برای تغییر رمز، ابتدا رمز فعلی را وارد کنید</p>

        <form @onsubmit="HandleSubmit" novalidate>
            <div class="auth-field">
                <label for="current">رمز عبور فعلی</label>
                <input id="current" type="password" class="form-control" @bind="CurrentPassword" autocomplete="current-password" />
                @if (FieldErrors.TryGetValue("current", out var currentError))
                {
                    <span class="field-error">@currentError</span>
                }
            </div>

            <div class="auth-field">
                <label for="password">رمز عبور جدید</label>
                <input id="password" type="password" class="form-control" @bind="Password" autocomplete="new-password" />
                @if (FieldErrors.TryGetValue("password", out var passwordError))
                {
                    <span class="field-error">@passwordError</span>
                }
            </div>

            <div class="auth-field">
                <label for="confirm">تکرار رمز عبور جدید</label>
                <input id="confirm" type="password" class="form-control" @bind="ConfirmPassword" autocomplete="new-password" />
                @if (FieldErrors.TryGetValue("confirm", out var confirmError))
                {
                    <span class="field-error">@confirmError</span>
                }
            </div>

            @if (ErrorMessage is not null)
            {
                <div class="auth-error" role="alert">@ErrorMessage</div>
            }

            <button type="submit" class="auth-button" disabled="@IsBusy">
                @(IsBusy ? "در حال ذخیره..." : "ذخیرهٔ رمز عبور")
            </button>
        </form>
    </div>
}

@code {
    private string CurrentPassword = string.Empty;
    private string Password = string.Empty;
    private string ConfirmPassword = string.Empty;
    private bool IsBusy;
    private bool Done;
    private string? ErrorMessage;
    private Dictionary<string, string> FieldErrors = new();

    private async Task HandleSubmit()
    {
        ErrorMessage = null;
        FieldErrors = new();

        if (string.IsNullOrWhiteSpace(CurrentPassword))
        {
            FieldErrors["current"] = "رمز عبور فعلی را وارد کنید.";
        }

        if (string.IsNullOrWhiteSpace(Password))
        {
            FieldErrors["password"] = "رمز عبور جدید را وارد کنید.";
        }
        else if (Password.Length < 8)
        {
            FieldErrors["password"] = "رمز عبور باید حداقل ۸ کاراکتر باشد.";
        }

        if (string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            FieldErrors["confirm"] = "تکرار رمز عبور را وارد کنید.";
        }
        else if (ConfirmPassword != Password)
        {
            FieldErrors["confirm"] = "تکرار رمز عبور مطابقت ندارد.";
        }

        if (FieldErrors.Count > 0)
        {
            return;
        }

        IsBusy = true;
        try
        {
            await AuthService.ChangePasswordAsync(CurrentPassword, Password);
            await AuthService.LogoutAsync(AuthState.CurrentSession?.RefreshToken ?? string.Empty);
            Done = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message == "Current password is incorrect."
                ? "رمز عبور فعلی اشتباه است."
                : ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }
}
