@page "/auth/callback"
@inject AuthStateProvider AuthState
@inject NavigationManager Nav
@inject ToastService ToastService

<PageTitle>ورود با گوگل</PageTitle>

<div class="auth-card">
    <LoadingSpinner Text="در حال تکمیل ورود با گوگل..." />
</div>

@code {
    [SupplyParameterFromQuery(Name = "access_token")]
    public string? AccessToken { get; set; }

    [SupplyParameterFromQuery(Name = "refresh_token")]
    public string? RefreshToken { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "google_error")]
    public string? Error { get; set; }

    private bool _handled;
    private bool _valid;

    protected override void OnInitialized()
    {
        if (_handled)
        {
            return;
        }
        _handled = true;

        if (!string.IsNullOrEmpty(Error))
        {
            ToastService.ShowError("ورود با گوگل ناموفق بود. دوباره تلاش کنید.");
            Nav.NavigateTo("/login");
            return;
        }

        if (string.IsNullOrWhiteSpace(AccessToken) || string.IsNullOrWhiteSpace(RefreshToken))
        {
            ToastService.ShowError("پاسخ ورود گوگل معتبر نیست. دوباره تلاش کنید.");
            Nav.NavigateTo("/login");
            return;
        }

        _valid = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_valid)
        {
            return;
        }

        // The server already exchanged the Google identity for our own JWT pair; the token
        // carries the user's claims (name/email/role). Sign in (persist + raise the auth-state
        // notification) and SPA-navigate — NOT a full reload, so the WASM app is never re-booted.
        // The delay lets the router's INITIAL navigation fully settle: raising the notification
        // while it is still in flight loses the cascading auth-state update (the layout keeps
        // the anonymous header — the very failure the old full reload worked around), whereas
        // after it settles the notification propagates exactly like the login-page flow.
        await Task.Delay(100);

        await AuthState.SignInWithTokensAsync(AccessToken!, RefreshToken!);

        Nav.NavigateTo(ReturnUrl is { } url && url.StartsWith('/') ? url : "/");
    }
}
