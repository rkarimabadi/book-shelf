@page "/library"
@attribute [Authorize]

<PageTitle>کتابخانهٔ من</PageTitle>

<div class="library-header">
    <h1 class="library-title">کتابخانهٔ من</h1>
    <p class="library-subtitle">کتاب‌هایی که ذخیره کرده‌اید</p>
</div>

@if (_error)
{
    <ErrorNotice Title="دریافت کتابخانه ناموفق بود"
                 Message="ارتباط با سرور برقرار نشد؛ لطفاً دوباره تلاش کنید."
                 Retry="LoadAsync" />
}
else if (_books is null)
{
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3" aria-hidden="true">
        @for (var i = 0; i < 8; i++)
        {
            <div class="col">
                <BookCard Skeleton="true" />
            </div>
        }
    </div>
}
else if (_books.Count == 0)
{
    <EmptyState Title="کتابخانه‌تان هنوز خالی است"
                Message="کتاب‌هایی را که دوست دارید به کتابخانه اضافه کنید تا این‌جا ببینیدشان."
                Icon="bi bi-book">
        <Action>
            <a class="btn btn-primary" href="books">مشاهدهٔ کتاب‌ها</a>
        </Action>
    </EmptyState>
}
else
{
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3">
        @foreach (var book in _books)
        {
            <div class="col">
                <div class="library-card">
                    <BookCard Book="book" InLibrary="true" />
                    <button type="button"
                            class="library-card-remove"
                            aria-label="حذف «@book.Title» از کتابخانه"
                            title="حذف از کتابخانه"
                            disabled="@(_removingId == book.Id)"
                            @onclick="() => AskRemove(book)">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}

<ConfirmDialog Visible="@(_pendingRemove is not null)"
               Title="حذف از کتابخانه"
               Message="@(_pendingRemove is null ? string.Empty : $"«{_pendingRemove.Title}» از کتابخانهٔ شما حذف شود؟")"
               ConfirmText="حذف"
               CancelText="انصراف"
               BusyText="در حال حذف..."
               IsBusy="@_isRemoving"
               OnConfirm="ConfirmRemoveAsync"
               OnCancel="CancelRemove" />

@code {
    [Inject]
    private IBookService BookService { get; set; } = default!;

    [Inject]
    private NavigationManager Nav { get; set; } = default!;

    [Inject]
    private ToastService ToastService { get; set; } = default!;

    private IReadOnlyList<BookResponse>? _books;
    private bool _error;
    private BookResponse? _pendingRemove;
    private Guid? _removingId;
    private bool _isRemoving;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = false;
        _books = null;

        var library = await BookService.GetMyLibraryAsync();
        _error = library is null;

        // BookCard consumes BookResponse. The card never renders CreatedAt/UpdatedAt, so mapping
        // AddedAt into both is harmless — but if a future card displays CreatedAt it would show the
        // library-add date. Keep that in mind if BookCard ever grows a date caption.
        _books = library?
            .Select(entry => new BookResponse(
                entry.Id,
                entry.Title,
                entry.Author,
                entry.Category,
                entry.Description,
                entry.CoverImagePath,
                entry.FilePath,
                entry.AddedAt,
                entry.AddedAt,
                IsActive: true)) // deactivated books are filtered out server-side
            .ToList();
    }

    private void AskRemove(BookResponse book)
    {
        _pendingRemove = book;
        _removingId = book.Id;
    }

    private void CancelRemove()
    {
        _pendingRemove = null;
        _removingId = null;
    }

    private async Task ConfirmRemoveAsync()
    {
        if (_pendingRemove is null || _isRemoving)
        {
            return;
        }

        var book = _pendingRemove;
        _isRemoving = true;

        try
        {
            var result = await BookService.RemoveFromLibraryAsync(book.Id);

            if (result.Unauthorized)
            {
                var returnUrl = Uri.EscapeDataString("/library");
                Nav.NavigateTo($"/login?returnUrl={returnUrl}");
                return;
            }

            if (result.Success)
            {
                _books = _books?.Where(b => b.Id != book.Id).ToList();
                ToastService.ShowSuccess($"«{book.Title}» از کتابخانهٔ شما حذف شد.");
            }
            else
            {
                ToastService.ShowError(result.Message ?? "حذف از کتابخانه ناموفق بود؛ دوباره تلاش کنید.");
            }

            _pendingRemove = null;
        }
        finally
        {
            _isRemoving = false;
            _removingId = null;
        }
    }
}
