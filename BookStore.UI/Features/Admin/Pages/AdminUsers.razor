@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject AuthenticationStateProvider AuthStateProvider
@inject IAdminUserService AdminUserService
@inject NavigationManager Nav
@inject ToastService ToastService

<PageTitle>مدیریت کاربران</PageTitle>

<div class="admin-header">
    <div>
        <h1 class="admin-title">مدیریت کاربران</h1>
        <p class="admin-subtitle">مشاهدهٔ کاربران، تغییر نقش، فعال/غیرفعال کردن و حذف حساب</p>
    </div>
</div>

@if (_error)
{
    <ErrorNotice Title="دریافت کاربران ناموفق بود"
                 Message="ارتباط با سرور برقرار نشد؛ لطفاً دوباره تلاش کنید."
                 Retry="LoadAsync" />
}
else if (_users is null)
{
    <LoadingSpinner Text="در حال بارگذاری کاربران..." />
}
else if (_users.Count == 0)
{
    <EmptyState Title="هنوز کاربری ثبت نشده است"
                Message="وقتی کاربری ثبت‌نام کند، اینجا نمایش داده می‌شود."
                Icon="bi bi-person" />
}
else
{
    <div class="admin-user-list">
        @foreach (var user in _users)
        {
            <AdminUserRow @key="user.Id"
                          User="user"
                          CurrentUserId="_currentUserId"
                          BusyId="_busyId"
                          OnToggleRole="() => ToggleRoleAsync(user)"
                          OnToggleStatus="() => ToggleStatusAsync(user)"
                          OnResetPassword="() => AskResetPassword(user)"
                          OnDelete="() => AskDelete(user)" />
        }
    </div>
}

@if (_deleteTarget is not null)
{
    <ConfirmDialog Visible="true"
                   Title="حذف کاربر"
                   Message="@($"آیا از حذف «{_deleteTarget.FirstName} {_deleteTarget.LastName}» مطمئن هستید؟ کتابخانه و تمام اطلاعات این کاربر حذف می‌شود.")"
                   ConfirmText="حذف"
                   BusyText="در حال حذف..."
                   IsBusy="_isDeleting"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CancelDelete" />
}

@if (_resetTarget is not null)
{
    <AdminUserPasswordDialog Visible="true"
                             Title="@($"تغییر رمز «{_resetTarget.FirstName} {_resetTarget.LastName}»")"
                             IsBusy="@_isResetting"
                             ErrorMessage="@_resetError"
                             @key="_resetTarget.Id"
                             OnSubmit="ConfirmResetPasswordAsync"
                             OnCancel="CancelResetPassword" />
}

@code {
    private IReadOnlyList<UserResponse>? _users;
    private bool _error;
    private UserResponse? _deleteTarget;
    private bool _isDeleting;
    private UserResponse? _resetTarget;
    private bool _isResetting;
    private string? _resetError;
    private Guid? _busyId;
    private Guid? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var sub = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _currentUserId = Guid.TryParse(sub, out var id) ? id : null;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = false;
        _users = null;
        _users = await AdminUserService.GetUsersAsync();
        _error = _users is null;
    }

    private void AskDelete(UserResponse user)
    {
        _deleteTarget = user;
    }

    private void CancelDelete()
    {
        _deleteTarget = null;
    }

    private void AskResetPassword(UserResponse user)
    {
        _resetTarget = user;
        _resetError = null;
    }

    private void CancelResetPassword()
    {
        _resetTarget = null;
        _resetError = null;
    }

    private async Task ConfirmResetPasswordAsync(string newPassword)
    {
        if (_resetTarget is null || _isResetting)
        {
            return;
        }

        _isResetting = true;
        _resetError = null;
        try
        {
            var result = await AdminUserService.ResetUserPasswordAsync(_resetTarget.Id, newPassword);

            if (result.Unauthorized)
            {
                _resetTarget = null;
                Nav.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString("/admin/users"));
                return;
            }

            if (result.Success)
            {
                ToastService.ShowSuccess($"رمز عبور «{_resetTarget.FirstName} {_resetTarget.LastName}» تغییر کرد و از همهٔ دستگاه‌ها خارج شد.");
                _resetTarget = null;
            }
            else if (result.Forbidden)
            {
                _resetError = "شما مجوز لازم برای این عملیات را ندارید.";
            }
            else
            {
                _resetError = result.Message;
            }
        }
        finally
        {
            _isResetting = false;
        }
    }

    private async Task ToggleStatusAsync(UserResponse user)
    {
        if (_busyId is not null)
        {
            return;
        }

        _busyId = user.Id;

        try
        {
            var result = await AdminUserService.SetUserStatusAsync(user.Id, !user.IsActive);

            if (result.Unauthorized)
            {
                Nav.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString("/admin/users"));
                return;
            }

            if (result.Success)
            {
                if (user.IsActive)
                {
                    ToastService.ShowSuccess($"حساب «{user.FirstName} {user.LastName}» مسدود شد و از سیستم خارج می‌شود.");
                }
                else
                {
                    ToastService.ShowSuccess($"حساب «{user.FirstName} {user.LastName}» دوباره فعال شد.");
                }
                await LoadAsync();
            }
            else if (result.Forbidden)
            {
                ToastService.ShowError("شما مجوز لازم برای این عملیات را ندارید.");
            }
            else
            {
                ToastService.ShowError(result.Message ?? "تغییر وضعیت کاربر ناموفق بود.");
            }
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task ToggleRoleAsync(UserResponse user)
    {
        if (_busyId is not null)
        {
            return;
        }

        _busyId = user.Id;

        try
        {
            var newRole = user.Role == "Admin" ? "User" : "Admin";
            var result = await AdminUserService.SetUserRoleAsync(user.Id, newRole);

            if (result.Unauthorized)
            {
                Nav.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString("/admin/users"));
                return;
            }

            if (result.Success)
            {
                ToastService.ShowSuccess($"نقش «{user.FirstName} {user.LastName}» به {(newRole == "Admin" ? "ادمین" : "کاربر")} تغییر کرد.");
                await LoadAsync();
            }
            else if (result.Forbidden)
            {
                ToastService.ShowError("شما مجوز لازم برای این عملیات را ندارید.");
            }
            else
            {
                ToastService.ShowError(result.Message ?? "تغییر نقش کاربر ناموفق بود.");
            }
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTarget is null || _isDeleting)
        {
            return;
        }

        _isDeleting = true;
        try
        {
            var result = await AdminUserService.DeleteUserAsync(_deleteTarget.Id);

            if (result.Unauthorized)
            {
                _deleteTarget = null;
                Nav.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString("/admin/users"));
                return;
            }

            _deleteTarget = null;

            if (result.Success)
            {
                ToastService.ShowSuccess("کاربر با موفقیت حذف شد.");
                await LoadAsync();
            }
            else if (result.Forbidden)
            {
                ToastService.ShowError("شما مجوز لازم برای این عملیات را ندارید.");
            }
            else
            {
                ToastService.ShowError(result.Message ?? "حذف کاربر ناموفق بود.");
            }
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
