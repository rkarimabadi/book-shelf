@page "/admin/edit/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>ویرایش کتاب</PageTitle>

@if (_error)
{
    <ErrorNotice Title="کتاب پیدا نشد"
                 Message="این کتاب وجود ندارد یا حذف شده است."
                 ShowRetry="false" />
}
else if (_book is null)
{
    <LoadingSpinner Text="در حال بارگذاری کتاب..." />
}
else
{
    <BookForm Existing="_book"
              IsBusy="_isBusy"
              ErrorMessage="@_errorMessage"
              OnSubmit="HandleSubmit"
              OnCancel="GoBack" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    private IBookService BookService { get; set; } = default!;

    [Inject]
    private IAdminBookService AdminBookService { get; set; } = default!;

    [Inject]
    private NavigationManager Nav { get; set; } = default!;

    [Inject]
    private ToastService ToastService { get; set; } = default!;

    private BookResponse? _book;
    private bool _error;
    private bool _isBusy;
    private string? _errorMessage;
    private Guid? _loadedId;

    // Route template is the same for every /admin/edit/{id}, so Blazor reuses this instance when
    // navigating between two books — OnInitializedAsync would not re-run. Reload when the id changes.
    protected override async Task OnParametersSetAsync()
    {
        if (Id != _loadedId)
        {
            _loadedId = Id;
            _book = null;
            _error = false;
            // includeInactive: admins must be able to edit deactivated books.
            _book = await BookService.GetBookAsync(Id, includeInactive: true);
            _error = _book is null;
        }
    }

    private void GoBack() => Nav.NavigateTo("/admin");

    private async Task HandleSubmit(BookFormSubmit form)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;
        try
        {
            var result = await AdminBookService.UpdateBookAsync(Id, form);

            if (result.Unauthorized)
            {
                Nav.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString($"/admin/edit/{Id}"));
                return;
            }

            if (result.Success)
            {
                ToastService.ShowSuccess("تغییرات کتاب ذخیره شد.");
                Nav.NavigateTo("/admin");
                return;
            }

            if (result.Forbidden)
            {
                _errorMessage = "شما مجوز لازم برای این عملیات را ندارید.";
                return;
            }

            _errorMessage = result.Message ?? "ذخیرهٔ تغییرات ناموفق بود؛ دوباره تلاش کنید.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
