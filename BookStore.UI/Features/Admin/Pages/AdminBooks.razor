@page "/admin"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>مدیریت کتاب‌ها</PageTitle>

<div class="admin-header">
    <div>
        <h1 class="admin-title">مدیریت کتاب‌ها</h1>
        <p class="admin-subtitle">افزودن، ویرایش و حذف کتاب‌ها</p>
    </div>
    <a class="admin-add-btn" href="admin/add">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        افزودن کتاب جدید
    </a>
</div>

@if (_error)
{
    <ErrorNotice Title="دریافت کتاب‌ها ناموفق بود"
                 Message="ارتباط با سرور برقرار نشد؛ لطفاً دوباره تلاش کنید."
                 Retry="LoadAsync" />
}
else if (_books is null)
{
    <LoadingSpinner Text="در حال بارگذاری کتاب‌ها..." />
}
else if (_books.Count == 0)
{
    <EmptyState Title="هنوز کتابی ثبت نشده است"
                Message="اولین کتاب خود را اضافه کنید تا در بخش عمومی نمایش داده شود."
                Icon="bi bi-book">
        <Action>
            <a class="btn btn-primary" href="admin/add">افزودن کتاب جدید</a>
        </Action>
    </EmptyState>
}
else
{
    <div class="admin-book-list">
        @foreach (var book in _books)
        {
            <AdminBookRow @key="book.Id"
                          Book="book"
                          TogglingId="_togglingId"
                          OnToggleStatus="() => ToggleStatusAsync(book)"
                          OnDelete="() => AskDelete(book)" />
        }
    </div>
}

@if (_deleteTarget is not null)
{
    <ConfirmDialog Visible="true"
                   Title="حذف کتاب"
                   Message="@($"آیا از حذف «{_deleteTarget.Title}» مطمئن هستید؟ این عمل قابل بازگشت نیست.")"
                   ConfirmText="حذف"
                   BusyText="در حال حذف..."
                   IsBusy="_isDeleting"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CancelDelete" />
}

@code {
    [Inject]
    private IAdminBookService AdminBookService { get; set; } = default!;

    [Inject]
    private NavigationManager Nav { get; set; } = default!;

    [Inject]
    private ToastService ToastService { get; set; } = default!;

    private IReadOnlyList<BookResponse>? _books;
    private bool _error;
    private BookResponse? _deleteTarget;
    private bool _isDeleting;
    private Guid? _togglingId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = false;
        _books = null;
        // Admin list includes deactivated books (they are hidden from the public catalog).
        _books = await AdminBookService.GetBooksAsync();
        _error = _books is null;
    }

    private void AskDelete(BookResponse book)
    {
        _deleteTarget = book;
    }

    private void CancelDelete()
    {
        _deleteTarget = null;
    }

    private async Task ToggleStatusAsync(BookResponse book)
    {
        if (_togglingId is not null)
        {
            return;
        }

        _togglingId = book.Id;

        try
        {
            var result = await AdminBookService.SetBookStatusAsync(book.Id, !book.IsActive);

            if (result.Unauthorized)
            {
                Nav.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString("/admin"));
                return;
            }

            if (result.Success)
            {
                if (book.IsActive)
                {
                    ToastService.ShowSuccess($"«{book.Title}» غیرفعال شد و از لیست عمومی و کتابخانهٔ کاربران حذف شد.");
                }
                else
                {
                    ToastService.ShowSuccess($"«{book.Title}» فعال شد و دوباره در لیست عمومی نمایش داده می‌شود.");
                }
                await LoadAsync();
            }
            else if (result.Forbidden)
            {
                ToastService.ShowError("شما مجوز لازم برای این عملیات را ندارید.");
            }
            else
            {
                ToastService.ShowError(result.Message ?? "تغییر وضعیت کتاب ناموفق بود.");
            }
        }
        finally
        {
            _togglingId = null;
        }
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTarget is null || _isDeleting)
        {
            return;
        }

        _isDeleting = true;
        try
        {
            var result = await AdminBookService.DeleteBookAsync(_deleteTarget.Id);

            if (result.Unauthorized)
            {
                _deleteTarget = null;
                Nav.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString("/admin"));
                return;
            }

            _deleteTarget = null;

            if (result.Success)
            {
                ToastService.ShowSuccess("کتاب با موفقیت حذف شد.");
                await LoadAsync();
            }
            else if (result.Forbidden)
            {
                ToastService.ShowError("شما مجوز لازم برای این عملیات را ندارید.");
            }
            else
            {
                ToastService.ShowError(result.Message ?? "حذف کتاب ناموفق بود.");
            }
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
