@if (Visible)
{
    <div class="password-overlay" role="presentation">
        <div class="password-dialog" role="dialog" aria-modal="true" aria-labelledby="password-dialog-title">
            <h2 id="password-dialog-title" class="password-dialog-title">@Title</h2>
            <p class="password-dialog-message">
                رمز جدید باید حداقل ۸ کاراکتر باشد. پس از ذخیره، کاربر از همهٔ دستگاه‌ها خارج می‌شود و باید با رمز جدید وارد شود.
            </p>

            <form @onsubmit="Submit" novalidate>
                <div class="password-field">
                    <label for="newPasswordInput">رمز عبور جدید</label>
                    <input id="newPasswordInput"
                           type="password"
                           class="password-input"
                           autocomplete="new-password"
                           autofocus
                           @bind="NewPassword"
                           @bind:event="oninput" />
                    @if (FieldErrors.TryGetValue("password", out var passwordError))
                    {
                        <span class="password-field-error">@passwordError</span>
                    }
                </div>

                <div class="password-field">
                    <label for="confirmPasswordInput">تکرار رمز عبور جدید</label>
                    <input id="confirmPasswordInput"
                           type="password"
                           class="password-input"
                           autocomplete="new-password"
                           @bind="ConfirmPassword"
                           @bind:event="oninput" />
                    @if (FieldErrors.TryGetValue("confirm", out var confirmError))
                    {
                        <span class="password-field-error">@confirmError</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="password-error" role="alert">
                        <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                        <span>@ErrorMessage</span>
                    </div>
                }

                <div class="password-actions">
                    <button type="button" class="password-btn password-btn-ghost" disabled="@IsBusy" @onclick="OnCancel">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                        انصراف
                    </button>
                    <button type="submit" class="password-btn password-btn-primary" disabled="@IsBusy">
                        <i class="bi @(IsBusy ? "bi-arrow-repeat bi-spin" : "bi-check-lg")" aria-hidden="true"></i>
                        @(IsBusy ? "در حال ذخیره..." : "ذخیرهٔ رمز")
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public bool Visible { get; set; }

    [Parameter]
    public string Title { get; set; } = "تغییر رمز عبور";

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<string> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string NewPassword = string.Empty;
    private string ConfirmPassword = string.Empty;
    private Dictionary<string, string> FieldErrors = new();

    private void Submit()
    {
        FieldErrors = new();

        if (string.IsNullOrWhiteSpace(NewPassword))
        {
            FieldErrors["password"] = "رمز عبور جدید را وارد کنید.";
        }
        else if (NewPassword.Length < 8)
        {
            FieldErrors["password"] = "رمز عبور باید حداقل ۸ کاراکتر باشد.";
        }

        if (string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            FieldErrors["confirm"] = "تکرار رمز عبور را وارد کنید.";
        }
        else if (ConfirmPassword != NewPassword)
        {
            FieldErrors["confirm"] = "تکرار رمز عبور مطابقت ندارد.";
        }

        if (FieldErrors.Count > 0)
        {
            return;
        }

        OnSubmit.InvokeAsync(NewPassword);
    }
}
