@page "/books/{Id:guid}"

<PageTitle>@(_book?.Title ?? "کتاب")</PageTitle>

@if (_error)
{
    <ErrorNotice Title="کتاب پیدا نشد"
                 Message="این کتاب وجود ندارد یا حذف شده است."
                 ShowRetry="false" />
}
else if (_book is null)
{
    <LoadingSpinner Text="در حال بارگذاری کتاب..." />
}
else
{
    <div class="row g-4 details-layout">
        <div class="col-12 col-sm-4 col-lg-3">
            <div class="details-cover">
                <BookCover Path="@_book.CoverImagePath" Alt="_book.Title" Eager="true" />
            </div>
        </div>

        <div class="col-12 col-sm-8 col-lg-9">
            <h1 class="details-title">@_book.Title</h1>
            <p class="details-author">@_book.Author</p>

            @if (!string.IsNullOrWhiteSpace(_book.Category))
            {
                <span class="details-category">
                    <i class="bi bi-tag" aria-hidden="true"></i>
                    @_book.Category
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(_book.Description))
            {
                <p class="details-description">@_book.Description</p>
            }
            else
            {
                <p class="details-description details-description-empty">توضیحی برای این کتاب ثبت نشده است.</p>
            }

            <div class="details-actions">
                @if (!string.IsNullOrWhiteSpace(_book.FilePath))
                {
                    if (_isAuthenticated)
                    {
                        <button type="button" class="book-action book-action-download"
                                disabled="@_isDownloading"
                                @onclick="OnDownloadClick">
                            <i class="bi @(_isDownloading ? "bi-arrow-repeat bi-spin" : "bi-download")" aria-hidden="true"></i>
                            @(_isDownloading ? "در حال دانلود..." : "دانلود کتاب")
                        </button>
                    }
                    else
                    {
                        <button type="button" class="book-action book-action-download"
                                @onclick="QueueDownloadAndRedirectToLogin">
                            <i class="bi bi-download" aria-hidden="true"></i>
                            دانلود کتاب
                        </button>
                    }
                }

                @if (_isAuthenticated)
                {
                    @if (_isInLibrary)
                    {
                        <button type="button" class="book-action book-action-remove"
                                disabled="@_isBusy"
                                @onclick="AskRemoveFromLibrary">
                            <i class="bi bi-bookmark-dash" aria-hidden="true"></i>
                            حذف از کتابخانه
                        </button>
                    }
                    else
                    {
                        <button type="button" class="book-action book-action-add"
                                disabled="@_isBusy"
                                @onclick="OnAddClick">
                            <i class="bi @(_isBusy ? "bi-arrow-repeat bi-spin" : "bi-bookmark-plus")" aria-hidden="true"></i>
                            @(_isBusy ? "در حال افزودن..." : "افزودن به کتابخانه")
                        </button>
                    }
                }
                else
                {
                    <button type="button" class="book-action book-action-add"
                            @onclick="QueueAddAndRedirectToLogin">
                        <i class="bi bi-bookmark-plus" aria-hidden="true"></i>
                        افزودن به کتابخانه
                    </button>
                }

                <button type="button" class="book-action book-action-copy"
                        disabled="@_isSharing"
                        @onclick="CopyLinkAsync">
                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                    کپی لینک
                </button>

                @if (_canShare)
                {
                    <button type="button" class="book-action book-action-share"
                            disabled="@_isSharing"
                            @onclick="ShareAsync">
                        <i class="bi bi-share" aria-hidden="true"></i>
                        اشتراک‌گذاری
                    </button>
                }
            </div>

            @if (_isAuthenticated)
            {
                <div class="details-note">
                    <div class="details-note-head">
                        <i class="bi bi-journal-text" aria-hidden="true"></i>
                        <span>یادداشت خصوصی</span>
                    </div>
                    <textarea class="details-note-input"
                              rows="4"
                              maxlength="1000"
                              placeholder="مثلاً: چند صفحه از این کتاب را خوانده‌ام، نظر شخصی من دربارهٔ آن..."
                              @bind="_note"
                              @bind:event="oninput"></textarea>
                    <div class="details-note-foot">
                        <span class="details-note-count">@_note.Length / 1000</span>
                        <button type="button" class="book-action book-action-save"
                                disabled="@_isSavingNote"
                                @onclick="SaveNoteAsync">
                            <i class="bi @(_isSavingNote ? "bi-arrow-repeat bi-spin" : "bi-check-lg")" aria-hidden="true"></i>
                            @(_isSavingNote ? "در حال ذخیره..." : "ذخیرهٔ یادداشت")
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

<ConfirmDialog Visible="@_showRemoveConfirm"
               Title="حذف از کتابخانه"
               Message="این کتاب از کتابخانهٔ شما حذف شود؟"
               ConfirmText="حذف"
               CancelText="انصراف"
               BusyText="در حال حذف..."
               IsBusy="@_isBusy"
               OnConfirm="ConfirmRemoveFromLibraryAsync"
               OnCancel="() => _showRemoveConfirm = false" />

@code {
    private const string PendingAddKey = "pending_add_book";
    private const string PendingDownloadKey = "pending_download_book";

    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    private IBookService BookService { get; set; } = default!;

    [Inject]
    private AuthStateProvider AuthState { get; set; } = default!;

    [Inject]
    private IClientStorageService Storage { get; set; } = default!;

    [Inject]
    private NavigationManager Nav { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private ToastService ToastService { get; set; } = default!;

    private BookResponse? _book;
    private bool _error;
    private bool _isAuthenticated;
    private bool _isInLibrary;
    private bool _isBusy;
    private bool _isDownloading;
    private bool _showRemoveConfirm;
    private bool _canShare;
    private bool _isSharing;
    private string _note = string.Empty;
    private bool _isSavingNote;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookAsync();
        await LoadAuthStateAsync();
        await ProcessPendingAddAsync();
        await ProcessPendingDownloadAsync();

        // Native share (Web Share API) is only available on some browsers (mostly mobile).
        _canShare = await JS.InvokeAsync<bool>("bookstoreCanShare");
    }

    private async Task LoadBookAsync()
    {
        _book = await BookService.GetBookAsync(Id);
        _error = _book is null;
    }

    private async Task LoadAuthStateAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;

        if (_isAuthenticated)
        {
            _isInLibrary = await BookService.IsInMyLibraryAsync(Id);
            _note = await BookService.GetBookNoteAsync(Id) ?? string.Empty;
        }
    }

    private async Task ProcessPendingAddAsync()
    {
        if (!_isAuthenticated)
        {
            return;
        }

        var pending = await Storage.GetItemAsync<string>(PendingAddKey);
        if (!Guid.TryParse(pending, out var pendingId))
        {
            await Storage.RemoveItemAsync(PendingAddKey);
            return;
        }

        // Pending add belongs to another book (e.g. user abandoned the login round-trip).
        if (pendingId != Id)
        {
            await Storage.RemoveItemAsync(PendingAddKey);
            return;
        }

        await Storage.RemoveItemAsync(PendingAddKey);
        await AddToLibraryAsync(fromPending: true);
    }

    private async Task ProcessPendingDownloadAsync()
    {
        if (!_isAuthenticated)
        {
            return;
        }

        var pending = await Storage.GetItemAsync<string>(PendingDownloadKey);
        if (!Guid.TryParse(pending, out var pendingId))
        {
            await Storage.RemoveItemAsync(PendingDownloadKey);
            return;
        }

        // Pending download belongs to another book (e.g. user abandoned the login round-trip).
        if (pendingId != Id)
        {
            await Storage.RemoveItemAsync(PendingDownloadKey);
            return;
        }

        await Storage.RemoveItemAsync(PendingDownloadKey);
        await DownloadAsync(fromPending: true);
    }

    private Task OnAddClick() => AddToLibraryAsync(fromPending: false);

    private string ShareUrl => Nav.Uri;

    private async Task CopyLinkAsync()
    {
        if (_isSharing)
        {
            return;
        }

        _isSharing = true;
        try
        {
            var copied = await JS.InvokeAsync<bool>("bookstoreCopyText", ShareUrl);
            if (copied)
            {
                ToastService.ShowSuccess("لینک کتاب کپی شد.");
            }
            else
            {
                ToastService.ShowError("کپی لینک ناموفق بود؛ لطفاً به‌صورت دستی کپی کنید.");
            }
        }
        finally
        {
            _isSharing = false;
        }
    }

    private async Task ShareAsync()
    {
        if (_isSharing)
        {
            return;
        }

        _isSharing = true;
        try
        {
            // Resolves false on cancel or failure — a user cancel is normal, so no error shown.
            await JS.InvokeAsync<bool>("bookstoreShare", _book?.Title ?? "کتاب", ShareUrl);
        }
        finally
        {
            _isSharing = false;
        }
    }

    private async Task SaveNoteAsync()
    {
        if (_isSavingNote)
        {
            return;
        }

        _isSavingNote = true;
        try
        {
            var result = await BookService.SaveBookNoteAsync(Id, _note);

            if (result.Unauthorized)
            {
                var returnUrl = Uri.EscapeDataString($"/books/{Id}");
                Nav.NavigateTo($"/login?returnUrl={returnUrl}");
                return;
            }

            if (result.Success)
            {
                ToastService.ShowSuccess("یادداشت شما ذخیره شد.");
            }
            else
            {
                ToastService.ShowError(result.Message ?? "ذخیرهٔ یادداشت ناموفق بود؛ دوباره تلاش کنید.");
            }
        }
        finally
        {
            _isSavingNote = false;
        }
    }

    private void AskRemoveFromLibrary() => _showRemoveConfirm = true;

    private async Task ConfirmRemoveFromLibraryAsync()
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;

        try
        {
            var result = await BookService.RemoveFromLibraryAsync(Id);

            if (result.Unauthorized)
            {
                var returnUrl = Uri.EscapeDataString($"/books/{Id}");
                Nav.NavigateTo($"/login?returnUrl={returnUrl}");
                return;
            }

            if (result.Success)
            {
                _isInLibrary = false;
                ToastService.ShowSuccess("کتاب از کتابخانهٔ شما حذف شد.");
            }
            else
            {
                ToastService.ShowError(result.Message ?? "حذف از کتابخانه ناموفق بود؛ دوباره تلاش کنید.");
            }

            _showRemoveConfirm = false;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task QueueAddAndRedirectToLogin()
    {
        await Storage.SetItemAsync(PendingAddKey, Id.ToString());
        var returnUrl = Uri.EscapeDataString($"/books/{Id}");
        Nav.NavigateTo($"/login?returnUrl={returnUrl}");
    }

    private Task OnDownloadClick() => DownloadAsync(fromPending: false);

    private async Task QueueDownloadAndRedirectToLogin()
    {
        await Storage.SetItemAsync(PendingDownloadKey, Id.ToString());
        var returnUrl = Uri.EscapeDataString($"/books/{Id}");
        Nav.NavigateTo($"/login?returnUrl={returnUrl}");
    }

    private async Task DownloadAsync(bool fromPending = false)
    {
        if (_isDownloading)
        {
            return;
        }

        _isDownloading = true;
        try
        {
            var result = await BookService.DownloadBookAsync(Id);

            if (result.Unauthorized && !fromPending)
            {
                await Storage.SetItemAsync(PendingDownloadKey, Id.ToString());
                var returnUrl = Uri.EscapeDataString($"/books/{Id}");
                Nav.NavigateTo($"/login?returnUrl={returnUrl}");
                return;
            }

            if (result.Unauthorized)
            {
                // Post-login auto-download still rejected; surface the error instead of bouncing to login again.
                ToastService.ShowError(result.Message ?? "نشست شما منقضی شده است؛ لطفاً دوباره وارد شوید.");
                return;
            }

            if (!result.Success)
            {
                ToastService.ShowError(result.Message ?? "دانلود کتاب ناموفق بود.");
                return;
            }

            await JS.InvokeVoidAsync("bookstoreDownload", result.Content!, DisplayFileName(_book?.FilePath));
            ToastService.ShowSuccess("دانلود شروع شد.");
        }
        finally
        {
            _isDownloading = false;
        }
    }

    private static string DisplayFileName(string? filePath)
    {
        var name = Path.GetFileName(filePath?.TrimEnd('/') ?? string.Empty);

        // Stored names look like "<32-hex>_<original name>"; strip the server-generated prefix.
        if (name.Length > 33 && name[32] == '_')
        {
            name = name[33..];
        }

        return string.IsNullOrWhiteSpace(name) ? "book.epub" : name;
    }

    private async Task AddToLibraryAsync(bool fromPending = false)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;

        try
        {
            var result = await BookService.AddToLibraryAsync(Id);

            if (result.Unauthorized && !fromPending)
            {
                await Storage.SetItemAsync(PendingAddKey, Id.ToString());
                var returnUrl = Uri.EscapeDataString($"/books/{Id}");
                Nav.NavigateTo($"/login?returnUrl={returnUrl}");
                return;
            }

            if (result.Unauthorized)
            {
                // Post-login auto-add still rejected; surface the error instead of bouncing to login again.
                ToastService.ShowError(result.Message ?? "نشست شما منقضی شده است؛ لطفاً دوباره وارد شوید.");
                return;
            }

            if (result.Success)
            {
                _isInLibrary = true;
                ToastService.ShowSuccess("کتاب با موفقیت به کتابخانهٔ شما اضافه شد.");
            }
            else
            {
                ToastService.ShowError(result.Message ?? "افزودن به کتابخانه ناموفق بود.");
            }
        }
        finally
        {
            _isBusy = false;
        }
    }
}
