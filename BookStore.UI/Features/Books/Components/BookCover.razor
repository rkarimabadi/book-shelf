@if (_failed || string.IsNullOrWhiteSpace(Path))
{
    <div class="cover-placeholder" aria-hidden="true">
        <span class="cover-placeholder-icon">📖</span>
    </div>
}
else
{
<img class="cover-image"
          src="@(Thumbnail ? IBookService.CoverThumbnailUrl(Path) : IBookService.MediaUrl(Path))"
          alt="@Alt"
          loading="@(Eager ? "eager" : "lazy")"
          @onerror="HandleImageError" />
}

@code {
    [Parameter, EditorRequired]
    public string? Path { get; set; }

    [Parameter]
    public string Alt { get; set; } = string.Empty;

    [Parameter]
    public bool Eager { get; set; }

    /// <summary>When true, requests the server-resized webp thumbnail instead of the full-size cover.</summary>
    [Parameter]
    public bool Thumbnail { get; set; }

    [Inject]
    private IBookService BookService { get; set; } = default!;

    private bool _failed;

    private void HandleImageError() => _failed = true;
}
