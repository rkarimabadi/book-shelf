@if (Skeleton)
{
    <div class="book-card book-card-skeleton" aria-hidden="true">
        <div class="skeleton-block skeleton-cover"></div>
        <div class="book-card-body">
            <div class="skeleton-block skeleton-line skeleton-line-wide"></div>
            <div class="skeleton-block skeleton-line skeleton-line-narrow"></div>
        </div>
    </div>
}
else
{
    @* A plain <a>, not NavLink: a child component's element never gets this file's CSS
       scope attribute, so .book-card styles (layout, border, label colour) did not apply. *@
    <a class="book-card" href="@($"/books/{Book.Id}{DetailQuery}")">
        <div class="details-cover book-card-cover">
            <BookCover Path="@Book.CoverImagePath" Alt="Book.Title" Thumbnail="true" />
            @if (ShowFormatBadge && FormatLabel.Length > 0)
            {
                <span class="book-card-badge badge-format" title="@($"فایل {FormatLabel}")">
                    <i class="bi @(FormatLabel == "PDF" ? "bi-file-earmark-pdf" : "bi-journal-richtext")" aria-hidden="true"></i>
                    @FormatLabel
                </span>
            }
            else if (InLibrary)
            {
                <span class="book-card-badge badge-library" role="img" aria-label="در کتابخانهٔ شما" title="در کتابخانهٔ شما">
                    <i class="bi bi-bookmark-check-fill" aria-hidden="true"></i>
                </span>
            }
        </div>
        <div class="book-card-body">
            <h3 class="book-card-title">@Book.Title</h3>
            <p class="book-card-author">@Book.Author</p>
            @if (!string.IsNullOrWhiteSpace(Book.Category))
            {
                <p class="book-card-category">
                    <i class="bi bi-tag" aria-hidden="true"></i>
                    @Book.Category
                </p>
            }
        </div>
    </a>
}

@code {
    // Required when Skeleton is false (skeleton mode renders placeholders instead).
    [Parameter]
    public BookResponse Book { get; set; } = default!;

    [Parameter]
    public bool Skeleton { get; set; }

    // Shows a small file-format badge («EPUB» / «PDF») on the cover corner (public catalog).
    [Parameter]
    public bool ShowFormatBadge { get; set; }

    private string FormatLabel => BookFileFormats.LabelFor(Book?.FilePath);

    // Shows a bookmark badge on the cover corner (user's library).
    [Parameter]
    public bool InLibrary { get; set; }

    // Optional query string appended to the detail link (the list's current filters, or a
    // "?from=library" marker) so the details page can offer a context-aware back link.
    [Parameter]
    public string? DetailQuery { get; set; }
}
