<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- Shared-hosting IIS often enables the WebDAV module, which claims
             PUT/DELETE/PATCH and returns "405 - HTTP verb used to access this
             page is not allowed" before the request reaches ASP.NET Core.
             Removing it lets all verbs through to the app. -->
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <security>
        <requestFiltering>
          <!-- Covers hosts that set denyUnlistedVerbs="true" (only listed verbs
               are allowed). Our API uses GET/HEAD/POST/PUT/PATCH/DELETE. -->
          <verbs>
            <add verb="GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS" allowed="true" />
          </verbs>
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet" arguments=".\BookStore.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- stdoutLogEnabled is ON for the Google OAuth / production diagnostics; it writes
           to the site's \logs\ folder, which must exist (create it next to web.config).
           Turn it off again once the issue is resolved if you don't want the log files. -->
    </system.webServer>
  </location>
</configuration>
